# One edge proxy, two explicit hosts. Never use shared generic Docker aliases.
(edge_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
sit.arenaops.in {
	import edge_headers
	route {
		@public_auth path /auth/realms/arena-sit /auth/realms/arena-sit/* /auth/resources/*
		reverse_proxy @public_auth sit-keycloak:8080
		@private_auth path /auth /auth/* /health /health/* /metrics /metrics/* /admin /admin/* /management /management/*
		respond @private_auth 404
		@api path /api /api/*
		handle @api {
			uri strip_prefix /api
			reverse_proxy sit-arena-login:7700
		}
		reverse_proxy sit-arena-ui:80
	}
}
arenaops.in {
	import edge_headers
	route {
		@public_auth path /auth/realms/arena /auth/realms/arena/* /auth/resources/*
		reverse_proxy @public_auth prod-keycloak:8080
		@private_auth path /auth /auth/* /health /health/* /metrics /metrics/* /admin /admin/* /management /management/*
		respond @private_auth 404
		@api path /api /api/*
		handle @api {
			uri strip_prefix /api
			reverse_proxy prod-arena-login:7700
		}
		reverse_proxy prod-arena-ui:80
	}
}
